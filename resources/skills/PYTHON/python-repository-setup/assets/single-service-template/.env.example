# Single service: this one file is both the service's runtime contract and the
# local Compose input (python-settings-config, references/env-example.md).
# Copy to .env for local use; .env is never committed. Compose-only values with
# a safe default in compose.yaml (such as APP_HOST_PORT) are not listed.

################################################################################
# REQUIRED — startup fails naming the variable when one is missing
################################################################################
ENVIRONMENT_NAME=local
